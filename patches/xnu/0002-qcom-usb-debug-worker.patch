+++ b/bsd/kern/bsd_init.c
@@ -108,6 +108,13 @@ <file scope>
 #include <kern/zalloc.h>
 #include <kern/ux_handler.h>            /* for ux_handler_setup() */
 #include <kern/sched_hygiene.h>
+#if XNU_QCOM_USB_DEBUG
+#include <QcomXnuUsbDebug.h>
+/* Not visible to this translation unit without MACH_KERNEL_PRIVATE. */
+#include <kern/cpu_number.h>
+#include <kern/processor.h>
+#include <kern/debug.h>
+#endif
 
 #if (DEVELOPMENT || DEBUG)
 #include <kern/debug.h>
@@ -1287,13 +1294,170 @@ bsdinit_task
 
 	load_init_program(p);
 	lock_trace = 1;
